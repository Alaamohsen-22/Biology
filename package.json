{
  "name": "life-secrets-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/verify-voice.mjs && tsc -b && vite build && node scripts/offline.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "preview": "vite preview --host 0.0.0.0",
    "build:review": "node scripts/verify-voice.mjs && tsc -b && vite build --mode review --outDir dist-review"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
